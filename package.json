{
  "name": "@jxtools/atlas",
  "version": "4.0.0",
  "description": "Verified task execution with resumable state and human-reviewed pull requests",
  "bin": {
    "atlas": "atlas.sh"
  },
  "files": [
    "atlas.sh",
    "lib/",
    "prompt.md",
    "plan_prompt.md",
    "review_prompt.md",
    "notify-telegram.sh",
    "templates/",
    "references/",
    "skills/",
    "scripts/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test tests/*.test.js && bats tests/",
    "check": "node scripts/check.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "atlas",
    "autonomous",
    "agent",
    "task-loop",
    "claude-code",
    "opencode",
    "codex",
    "ai",
    "automation",
    "backlog"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juancruzrossi/atlas.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "bats": "^1.13.0"
  }
}
